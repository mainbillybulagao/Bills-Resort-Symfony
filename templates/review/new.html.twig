
{% extends 'base.html.twig' %}

{% block title %}Write a Review | Bill's Resort{% endblock %}

{% block body %}

<style>
    /* CENTER THE REVIEW PAGE */
    .review-page {
        width: 100%;
        max-width: 750px;
        margin: 40px auto !important;
        padding: 20px;
        box-sizing: border-box;
        color: #124d57;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    .review-heading {
        text-align: center;
        margin-bottom: 30px;
    }

    .review-heading span {
        color: #17606b;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 3px;
    }

    .review-heading h1 {
        font-family: 'Lora', serif;
        font-size: 34px;
        margin: 12px 0;
        color: #17606b;
    }

    .review-heading p {
        color: #64777a;
        font-size: 15px;
        line-height: 1.6;
    }

    .review-card {
        width: 100%;
        background: #ffffff;
        padding: 35px;
        border-radius: 14px;
        border: 1px solid #dce9e9;
        box-shadow: 0 5px 20px rgba(18, 77, 87, 0.08);
        box-sizing: border-box;
    }

    .review-card h2 {
        font-family: 'Lora', serif;
        font-size: 23px;
        margin-bottom: 10px;
        text-align: center;
    }

    .review-description {
        text-align: center;
        color: #64777a;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .review-card form label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #124d57;
    }

    .review-card form input,
    .review-card form select,
    .review-card form textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        margin-bottom: 18px;
        border: 1px solid #c5d8da;
        border-radius: 7px;
        background: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
    }

    .review-card form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .review-card form input:focus,
    .review-card form select:focus,
    .review-card form textarea:focus {
        outline: none;
        border-color: #17606b;
        box-shadow: 0 0 0 3px rgba(23, 96, 107, 0.10);
    }

    .review-card form button,
    .review-card form .btn {
        padding: 13px 22px;
        background: #17606b;
        color: #ffffff;
        border: none;
        border-radius: 7px;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .review-card form button:hover,
    .review-card form .btn:hover {
        background: #124d57;
    }

    .review-actions {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }

    .review-back {
        display: inline-block;
        padding: 12px 22px;
        background: #dce9e9;
        color: #124d57;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .review-back:hover {
        background: #c5d8da;
    }

    @media (max-width: 600px) {
        .review-page {
            padding: 15px;
            margin: 20px auto !important;
        }

        .review-heading h1 {
            font-size: 28px;
        }

        .review-card {
            padding: 22px;
        }
    }
</style>

<div class="review-page">

    <div class="review-heading">
        <span>YOUR EXPERIENCE MATTERS</span>
        <h1>WRITE A REVIEW</h1>
        <p>
            Thank you for choosing Bill's Resort.
            Share your experience and help us improve our services.
        </p>
    </div>

    <div class="review-card">

        <h2>Share Your Experience</h2>

        <p class="review-description">
            We would love to hear your feedback about your stay.
        </p>

        {{ include('review/_form.html.twig') }}

        <div class="review-actions">
            <a href="{{ path('app_review_index') }}" class="review-back">
                BACK TO LIST
            </a>
        </div>

    </div>

</div>

{% endblock %}
