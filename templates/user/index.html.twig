{% extends 'base.html.twig' %}

{% block title %}User Management | Bill's Resort Admin{% endblock %}

{% block body %}

<style>
    /* =====================================================
       USER MANAGEMENT PAGE
       ===================================================== */

    .user-management-page {
        width: 100%;
    }

    .user-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 28px;
    }

    .user-page-header h1 {
        color: #124d57;
        font-family: 'Lora', serif;
        font-size: 30px;
        margin-bottom: 8px;
    }

    .user-page-header p {
        color: #718487;
        font-size: 13px;
    }

    /* CREATE BUTTON */

    .create-user-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 19px;
        background: #17606b;
        color: #ffffff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .create-user-btn:hover {
        background: #124d57;
        transform: translateY(-2px);
    }

    /* ALERTS */

    .user-alert {
        padding: 14px 18px;
        margin-bottom: 15px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .user-alert-success {
        background: #e5f3eb;
        border: 1px solid #c5e4d1;
        color: #27734a;
    }

    .user-alert-danger {
        background: #fceaea;
        border: 1px solid #f0caca;
        color: #a83232;
    }

    /* TABLE CARD */

    .user-table-card {
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 4px 18px rgba(18, 77, 87, 0.06);
    }

    .user-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-bottom: 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e5eeee;
    }

    .user-table-header h2 {
        color: #124d57;
        font-family: 'Lora', serif;
        font-size: 20px;
    }

    .user-count-label {
        padding: 7px 13px;
        background: #e8f2f2;
        color: #17606b;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    /* TABLE */

    .user-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .user-management-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
    }

    .user-management-table thead {
        background: #f0f7f7;
    }

    .user-management-table th {
        padding: 15px 13px;
        color: #526b6e;
        text-align: left;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .user-management-table td {
        padding: 16px 13px;
        border-bottom: 1px solid #edf2f2;
        color: #526367;
        font-size: 11px;
        vertical-align: middle;
    }

    .user-management-table tbody tr:hover {
        background: #f8fbfb;
    }

    .user-id {
        color: #17606b;
        font-weight: 700;
    }

    .user-name {
        color: #124d57;
        font-weight: 700;
    }

    /* ROLE BADGES */

    .user-role {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .role-admin {
        background: #eee8fa;
        color: #7044a5;
    }

    .role-staff {
        background: #e5f0fa;
        color: #326b9e;
    }

    .role-customer {
        background: #e5f3eb;
        color: #27734a;
    }

    .role-unknown {
        background: #eeeeee;
        color: #666666;
    }

    /* STATUS BADGES */

    .user-status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e5f3eb;
        color: #27734a;
    }

    .status-inactive {
        background: #fceaea;
        color: #a83232;
    }

    /* ACTION BUTTONS */

    .user-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .user-action-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 7px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 9px;
        font-weight: 700;
        transition: 0.2s ease;
        border: none;
        cursor: pointer;
    }

    .user-view-btn {
        background: #e8f2f2;
        color: #17606b;
    }

    .user-edit-btn {
        background: #e5f0fa;
        color: #326b9e;
    }

    .user-view-btn:hover,
    .user-edit-btn:hover {
        opacity: 0.75;
    }

    .user-delete-form {
        display: inline-flex;
        margin: 0;
    }

    .user-delete-btn {
        background: #fceaea;
        color: #a83232;
    }

    .user-delete-btn:hover {
        background: #a83232;
        color: #ffffff;
    }

    .your-account-label {
        color: #819295;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* EMPTY STATE */

    .user-empty-state {
        padding: 45px 20px !important;
        text-align: center;
        color: #819295 !important;
        font-size: 13px !important;
    }

    /* RESPONSIVE */

    @media (max-width: 600px) {
        .user-page-header h1 {
            font-size: 25px;
        }

        .user-table-card {
            padding: 18px;
        }

        .user-page-header {
            align-items: flex-start;
        }

        .create-user-btn {
            width: 100%;
        }
    }
</style>


<div class="user-management-page">

    <!-- PAGE HEADER -->

    <div class="user-page-header">

        <div>
            <h1>User Management</h1>
            <p>Manage administrator, staff, and customer accounts.</p>
        </div>

        <a href="{{ path('app_user_new') }}" class="create-user-btn">
            + CREATE NEW ACCOUNT
        </a>

    </div>


    <!-- FLASH MESSAGES -->

    {% for message in app.flashes('success') %}
        <div class="user-alert user-alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="user-alert user-alert-danger">
            {{ message }}
        </div>
    {% endfor %}


    <!-- USER TABLE -->

    <div class="user-table-card">

        <div class="user-table-header">

            <h2>ALL USER ACCOUNTS</h2>

            <span class="user-count-label">
                {{ users|length }} USER ACCOUNTS
            </span>

        </div>


        <div class="user-table-responsive">

            <table class="user-management-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>NAME</th>
                        <th>EMAIL</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th>DATE CREATED</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>


                <tbody>

                    {% for user in users %}

                        <tr>

                            <td class="user-id">
                                #{{ user.id }}
                            </td>

                            <td class="user-name">
                                {{ user.name }}
                            </td>

                            <td>
                                {{ user.email }}
                            </td>


                            <!-- USER ROLE -->

                            <td>

                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="user-role role-admin">ADMIN</span>

                                {% elseif 'ROLE_STAFF' in user.roles %}
                                    <span class="user-role role-staff">STAFF</span>

                                {% elseif 'ROLE_CUSTOMER' in user.roles %}
                                    <span class="user-role role-customer">CUSTOMER</span>

                                {% else %}
                                    <span class="user-role role-unknown">USER</span>
                                {% endif %}

                            </td>


                            <!-- ACCOUNT STATUS -->

                            <td>

                                {% if user.status|lower == 'active' %}
                                    <span class="user-status status-active">
                                        ACTIVE
                                    </span>
                                {% else %}
                                    <span class="user-status status-inactive">
                                        {{ user.status|upper }}
                                    </span>
                                {% endif %}

                            </td>


                            <td>
                                {{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}
                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="user-actions">

                                    <a
                                        href="{{ path('app_user_show', {'id': user.id}) }}"
                                        class="user-action-btn user-view-btn"
                                    >
                                        VIEW
                                    </a>

                                    <a
                                        href="{{ path('app_user_edit', {'id': user.id}) }}"
                                        class="user-action-btn user-edit-btn"
                                    >
                                        EDIT
                                    </a>

                                    {% if app.user.id != user.id %}

                                        {{ include('user/_delete_form.html.twig') }}

                                    {% else %}

                                        <span class="your-account-label">
                                            YOUR ACCOUNT
                                        </span>

                                    {% endif %}

                                </div>

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="7" class="user-empty-state">
                                No user accounts found.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}