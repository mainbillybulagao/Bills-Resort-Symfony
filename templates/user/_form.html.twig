
<style>
    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .admin-form label {
        display: block;
        color: #124d57;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .admin-form input,
    .admin-form select,
    .admin-form textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #cbdada;
        border-radius: 7px;
        margin-bottom: 18px;
        font-family: "Montserrat", sans-serif;
        font-size: 14px;
        box-sizing: border-box;
    }

    .admin-form input:focus,
    .admin-form select:focus,
    .admin-form textarea:focus {
        outline: none;
        border-color: #17606b;
        box-shadow: 0 0 0 3px rgba(23, 96, 107, 0.10);
    }

    .admin-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 15px;
    }

    .admin-form-actions button,
    .admin-form-actions a {
        display: inline-block;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: none;
    }

    .admin-form-actions button {
        background: #17606b;
        color: #ffffff;
    }

    .admin-form-actions button:hover {
        background: #124d57;
    }

    .admin-form-actions a {
        background: #e7eeee;
        color: #124d57;
    }

    .admin-form-actions a:hover {
        background: #dce9e9;
    }

    .admin-form .form-error-message {
        color: #c0392b;
        font-size: 12px;
        margin-top: -12px;
        margin-bottom: 12px;
    }

    @media (max-width: 600px) {
        .admin-form-actions {
            flex-direction: column;
        }

        .admin-form-actions button,
        .admin-form-actions a {
            text-align: center;
        }
    }
</style>

{{ form_start(form) }}

<div class="admin-form">

    {{ form_row(form.name) }}

    {{ form_row(form.email) }}

    {{ form_row(form.roles) }}

    {{ form_row(form.status) }}

    {{ form_row(form.plainPassword) }}

    <div class="admin-form-actions">

        <button type="submit">
            {{ button_label|default('SAVE ACCOUNT') }}
        </button>

        <a href="{{ path('app_user_index') }}">
            CANCEL
        </a>

    </div>

</div>

{{ form_end(form) }}
