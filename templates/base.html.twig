
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Bill's Resort{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
</head>

<body>

    {% include 'partials/topbar.html.twig' %}

    <div class="admin-layout {% if is_granted('ROLE_CUSTOMER') and not is_granted('ROLE_STAFF') %}customer-layout{% endif %}">

        {% if is_granted('ROLE_ADMIN') %}
            {% include 'partials/sidebar.html.twig' %}

        {% elseif is_granted('ROLE_STAFF') %}
            {% include 'partials/staff_sidebar.html.twig' %}
        {% endif %}

        <main class="admin-content">
            {% block body %}{% endblock %}
        </main>

    </div>

    {% include 'partials/footer.html.twig' %}

</body>
</html>