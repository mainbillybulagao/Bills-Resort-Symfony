
{% extends 'base.html.twig' %}

{% block title %}Messages | Bill's Resort Admin{% endblock %}

{% block body %}

<style>
    .messages-page {
        padding: 25px;
        color: #124d57;
    }

    .messages-header {
        margin-bottom: 25px;
    }

    .messages-header h1 {
        font-family: "Lora", serif;
        font-size: 30px;
        margin-bottom: 8px;
        color: #124d57;
    }

    .messages-header p {
        color: #647779;
        font-size: 14px;
    }

    .messages-alert {
        padding: 13px 16px;
        border-radius: 7px;
        margin-bottom: 15px;
        font-size: 13px;
    }

    .messages-alert.success {
        background: #e2f3e8;
        color: #237342;
    }

    .messages-alert.error {
        background: #fce7e7;
        color: #a33a3a;
    }

    .messages-summary {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-left: 5px solid #17606b;
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 25px;
        box-shadow: 0 3px 12px rgba(18, 77, 87, 0.06);
    }

    .messages-summary-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dce9e9;
        border-radius: 10px;
        font-size: 22px;
    }

    .messages-summary h3 {
        font-size: 13px;
        color: #647779;
        margin: 0 0 5px;
    }

    .messages-summary strong {
        font-size: 25px;
        color: #124d57;
    }

    .messages-section {
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(18, 77, 87, 0.07);
    }

    .messages-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 12px;
    }

    .messages-section-header h2 {
        font-size: 19px;
        color: #17606b;
        margin: 0;
    }

    .messages-count {
        background: #dce9e9;
        color: #124d57;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .messages-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .messages-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

    .messages-table thead {
        background: #17606b;
        color: #ffffff;
    }

    .messages-table th {
        padding: 15px 13px;
        text-align: left;
        font-size: 11px;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .messages-table td {
        padding: 15px 13px;
        border-bottom: 1px solid #e5eeee;
        color: #526466;
        font-size: 13px;
        vertical-align: top;
    }

    .messages-table tbody tr:hover {
        background: #f5f9f9;
    }

    .message-customer {
        color: #124d57;
        font-weight: 700;
    }

    .message-email {
        color: #17606b;
        text-decoration: none;
    }

    .message-email:hover {
        text-decoration: underline;
    }

    .message-subject {
        font-weight: 600;
        color: #124d57;
    }

    .message-content {
    display: block;
    width: 220px;
    min-width: 180px;
    max-width: 260px;
    color: #526466;
    line-height: 1.6;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: normal;
}

    .message-date {
        white-space: nowrap;
        font-size: 12px;
        color: #718184;
    }

    .message-delete-btn {
        background: #c0392b;
        color: #ffffff;
        border: none;
        padding: 9px 15px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .message-delete-btn:hover {
        background: #962d22;
    }

    .messages-empty {
        text-align: center;
        padding: 55px 20px;
        background: #f7fafa;
        border-radius: 9px;
    }

    .messages-empty .empty-icon {
        font-size: 38px;
        margin-bottom: 12px;
    }

    .messages-empty h2 {
        color: #124d57;
        font-size: 20px;
        margin-bottom: 8px;
    }

    .messages-empty p {
        color: #718184;
        font-size: 13px;
    }

    @media (max-width: 600px) {
        .messages-page {
            padding: 15px;
        }

        .messages-section {
            padding: 17px;
        }

        .messages-header h1 {
            font-size: 25px;
        }
    }
</style>

<div class="messages-page">

    <div class="messages-header">
        <h1>MESSAGES</h1>
        <p>View and manage customer messages sent to Bill's Resort.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="messages-alert success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="messages-alert error">
            {{ message }}
        </div>
    {% endfor %}

    <div class="messages-summary">

        <div class="messages-summary-icon">
            &#9993;
        </div>

        <div>
            <h3>TOTAL CUSTOMER MESSAGES</h3>
            <strong>{{ messages|length }}</strong>
        </div>

    </div>

    <div class="messages-section">

        <div class="messages-section-header">
            <h2>MESSAGE MANAGEMENT</h2>

            <span class="messages-count">
                {{ messages|length }} MESSAGES
            </span>
        </div>

        {% if messages is not empty %}

            <div class="messages-table-wrapper">

                <table class="messages-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>CUSTOMER NAME</th>
                            <th>EMAIL</th>
                            <th>SUBJECT</th>
                            <th>MESSAGE</th>
                            <th>DATE SENT</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for message in messages %}

                            <tr>

                                <td>{{ message.id }}</td>

                                <td class="message-customer">
                                    {{ message.name }}
                                </td>

                                <td>
                                    <a href="mailto:{{ message.email }}" class="message-email">
                                        {{ message.email }}
                                    </a>
                                </td>

                                <td class="message-subject">
                                    {{ message.subject }}
                                </td>

                                <td>
                                    <div class="message-content">
                                        {{ message.message }}
                                    </div>
                                </td>

                                <td class="message-date">
                                    {{ message.createdAt ? message.createdAt|date('M d, Y h:i A') : 'N/A' }}
                                </td>

                                <td>
                                    <form method="post"
                                          action="{{ path('app_admin_message_delete', {'id': message.id}) }}"
                                          onsubmit="return confirm('Are you sure you want to delete this message? This action cannot be undone.');">

                                        <input type="hidden"
                                               name="_token"
                                               value="{{ csrf_token('delete_message_' ~ message.id) }}">

                                        <button type="submit" class="message-delete-btn">
                                            DELETE
                                        </button>

                                    </form>
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        {% else %}

            <div class="messages-empty">
                <div class="empty-icon">&#9993;</div>
                <h2>No Messages Yet</h2>
                <p>Customer messages will appear here once submitted.</p>
            </div>

        {% endif %}

    </div>

</div>

{% endblock %}
