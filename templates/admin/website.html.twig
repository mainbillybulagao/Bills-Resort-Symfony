
{% extends 'base.html.twig' %}

{% block title %}
    Bill's Resort Website | Admin
{% endblock %}

{% block body %}

    <h1>VIEW WEBSITE</h1>

    <p>
        Preview the public Bill's Resort website.
    </p>

    <div class="admin-section">

        <div class="admin-section-header">
            <h2>WEBSITE PREVIEW</h2>
        </div>

        <div class="no-data">

            <h2>Bill's Resort Website</h2>

            <p>
                Click the button below to open the public website.
            </p>

            <a href="{{ path('app_home') }}"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary">

                VIEW PUBLIC WEBSITE

            </a>

        </div>

    </div>

{% endblock %}
