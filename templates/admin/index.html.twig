
{% extends 'base.html.twig' %}

{% block title %}
    Admin Dashboard | Bill's Resort
{% endblock %}

{% block body %}

    <h1>DASHBOARD</h1>

    <p>
        Welcome to Bill's Resort Administration.
    </p>

    <div class="dashboard-cards">

        <div class="dashboard-card">
            <h3>REGISTERED USERS</h3>
            <p class="number">{{ totalUsers }}</p>
        </div>

        <div class="dashboard-card">
            <h3>ROOMS</h3>
            <p class="number">{{ totalRooms }}</p>
        </div>

        <div class="dashboard-card">
            <h3>TOTAL BOOKINGS</h3>
            <p class="number">{{ totalBookings }}</p>
        </div>

        <div class="dashboard-card">
            <h3>PENDING BOOKINGS</h3>
            <p class="number">{{ pendingBookings }}</p>
        </div>

    </div>

{% endblock %}
