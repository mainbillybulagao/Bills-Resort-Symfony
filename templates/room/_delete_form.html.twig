<form
    method="post"
    action="{{ path('app_room_delete', {'id': room.id}) }}"
    onsubmit="return confirm('Are you sure you want to delete this room?');"
    class="room-delete-form"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ room.id) }}"
    >

    <button type="submit" class="delete-room-btn">
        DELETE ROOM
    </button>
</form>

<style>
    .room-delete-form {
        display: inline-flex;
        margin: 0;
    }

    .delete-room-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 12px 21px;
        border: none;
        border-radius: 8px;
        background: #fceaea;
        color: #a83232;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .delete-room-btn:hover {
        background: #a83232;
        color: #ffffff;
        transform: translateY(-2px);
    }

    @media (max-width: 600px) {
        .room-delete-form,
        .delete-room-btn {
            width: 100%;
        }
    }
</style>