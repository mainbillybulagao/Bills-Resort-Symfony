{% extends 'base.html.twig' %}

{% block title %}Rooms Management | Bill's Resort{% endblock %}

{% block body %}

<style>
    .rooms-page {
        max-width: 1250px;
        margin: 0 auto;
    }

    .rooms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 30px;
    }

    .rooms-header h1 {
        color: #124d57;
        font-size: 28px;
        margin: 0 0 8px;
    }

    .rooms-header p {
        color: #718486;
        margin: 0;
        font-size: 14px;
    }

    .add-room-btn {
        background: #17606b;
        color: #fff;
        padding: 13px 21px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: 0.2s;
    }

    .add-room-btn:hover {
        background: #124d57;
    }

    .room-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .summary-card {
        background: #fff;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e1ebeb;
        box-shadow: 0 4px 12px rgba(18, 77, 87, 0.05);
    }

    .summary-card h3 {
        color: #718486;
        font-size: 12px;
        letter-spacing: 1px;
        margin: 0 0 12px;
    }

    .summary-card strong {
        color: #17606b;
        font-size: 29px;
    }

    .rooms-table-card {
        background: #fff;
        border-radius: 13px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(18, 77, 87, 0.06);
        border: 1px solid #e1ebeb;
    }

    .table-heading {
        margin-bottom: 20px;
    }

    .table-heading h2 {
        color: #124d57;
        font-size: 19px;
        margin: 0 0 6px;
    }

    .table-heading p {
        color: #849597;
        font-size: 13px;
        margin: 0;
    }

    .table-scroll {
        overflow-x: auto;
    }

    .rooms-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

    .rooms-table th {
        background: #f0f6f6;
        color: #527075;
        font-size: 11px;
        letter-spacing: 0.8px;
        text-align: left;
        padding: 15px 12px;
        text-transform: uppercase;
    }

    .rooms-table td {
        padding: 15px 12px;
        border-bottom: 1px solid #edf1f1;
        color: #52676a;
        font-size: 13px;
        vertical-align: middle;
    }

    .rooms-table tbody tr:hover {
        background: #f8fbfb;
    }

    .room-photo {
        width: 85px;
        height: 65px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e1ebeb;
        display: block;
        background: #f0f6f6;
    }

    .room-name {
        color: #124d57;
        font-weight: 700;
    }

    .room-price {
        color: #17606b;
        font-weight: 700;
    }

    .room-status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        background: #e4f3ed;
        color: #267452;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .room-actions {
        display: flex;
        gap: 7px;
    }

    .room-actions a {
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
    }

    .view-btn {
        background: #e9f2f3;
        color: #17606b;
    }

    .edit-btn {
        background: #17606b;
        color: #fff;
    }

    .view-btn:hover {
        background: #d9e9eb;
    }

    .edit-btn:hover {
        background: #124d57;
    }

    .empty-rooms {
        text-align: center;
        padding: 35px !important;
        color: #829497 !important;
    }

    @media (max-width: 850px) {
        .room-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 550px) {
        .room-summary {
            grid-template-columns: 1fr;
        }

        .rooms-header h1 {
            font-size: 23px;
        }

        .rooms-table-card {
            padding: 15px;
        }
    }
</style>

<div class="rooms-page">

    <div class="rooms-header">
        <div>
            <h1>ROOMS MANAGEMENT</h1>
            <p>Manage your resort rooms, room information, and availability.</p>
        </div>

        <a href="{{ path('app_room_new') }}" class="add-room-btn">
            + ADD NEW ROOM
        </a>
    </div>

    <div class="room-summary">

        <div class="summary-card">
            <h3>TOTAL ROOMS</h3>
            <strong>{{ rooms|length }}</strong>
        </div>

        <div class="summary-card">
            <h3>AVAILABLE ROOMS</h3>
            <strong>{{ rooms|filter(room => room.status == 'Available')|length }}</strong>
        </div>

        <div class="summary-card">
            <h3>UNAVAILABLE ROOMS</h3>
            <strong>{{ rooms|filter(room => room.status != 'Available')|length }}</strong>
        </div>

    </div>

    <div class="rooms-table-card">

        <div class="table-heading">
            <h2>All Resort Rooms</h2>
            <p>Room details and management actions</p>
        </div>

        <div class="table-scroll">
            <table class="rooms-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ROOM</th>
                        <th>DESCRIPTION</th>
                        <th>PRICE</th>
                        <th>STATUS</th>
                        <th>CREATED AT</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>

                <tbody>
                    {% for room in rooms %}
                        <tr>
                            <td>{{ room.id }}</td>

                            <td>
                                <div style="display:flex; align-items:center; gap:12px;">
                                    {% if room.image %}
                                        <img
                                            src="{{ asset('images/' ~ room.image) }}"
                                            alt="{{ room.roomName }}"
                                            class="room-photo"
                                        >
                                    {% else %}
                                        <div class="room-photo"></div>
                                    {% endif %}

                                    <span class="room-name">{{ room.roomName }}</span>
                                </div>
                            </td>

                            <td>{{ room.description }}</td>

                            <td class="room-price">₱{{ room.price }}</td>

                            <td>
                                <span class="room-status">{{ room.status }}</span>
                            </td>

                            <td>
                                {{ room.createdAt ? room.createdAt|date('M d, Y') : '' }}
                            </td>

                            <td>
                                <div class="room-actions">
                                    <a href="{{ path('app_room_show', {'id': room.id}) }}"
                                       class="view-btn">VIEW</a>

                                    <a href="{{ path('app_room_edit', {'id': room.id}) }}"
                                       class="edit-btn">EDIT</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="empty-rooms">
                                No rooms available. Click "Add New Room" to create your first room.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        </div>

    </div>

</div>

{% endblock %}