
{% extends 'base.html.twig' %}

{% block title %}
    Staff Dashboard | Bill's Resort
{% endblock %}

{% block body %}

<style>
    .staff-dashboard {
        width: 100%;
    }

    .staff-heading {
        margin-bottom: 30px;
    }

    .staff-heading h1 {
        color: #124d57;
        font-size: 28px;
        margin-bottom: 8px;
    }

    .staff-heading p {
        color: #687b7e;
        font-size: 14px;
        line-height: 1.6;
    }

    .staff-dashboard .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .staff-dashboard .dashboard-card {
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-left: 4px solid #17606b;
        border-radius: 10px;
        padding: 23px 20px;
        box-shadow: 0 3px 12px rgba(18, 77, 87, 0.05);
    }

    .staff-dashboard .dashboard-card h3 {
        color: #687b7e;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin: 0 0 14px;
    }

    .staff-dashboard .dashboard-card .number {
        color: #124d57;
        font-size: 30px;
        font-weight: 700;
        margin: 0;
    }

    .staff-section {
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 12px rgba(18, 77, 87, 0.05);
    }

    .staff-section-header {
        border-bottom: 1px solid #e3eded;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .staff-section-header h2 {
        color: #124d57;
        font-size: 17px;
        margin: 0;
    }

    .staff-quick-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
    }

    .staff-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 48px;
        padding: 12px 15px;
        border-radius: 7px;
        background: #17606b;
        color: #ffffff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: background 0.2s ease;
    }

    .staff-action-btn:hover {
        background: #124d57;
    }

    .staff-reminder {
        background: #f0f6f6;
        border-left: 4px solid #17606b;
        border-radius: 7px;
        padding: 18px 20px;
        color: #52696c;
        font-size: 14px;
        line-height: 1.8;
    }

    @media (max-width: 1000px) {
        .staff-dashboard .dashboard-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 650px) {
        .staff-heading h1 {
            font-size: 23px;
        }

        .staff-dashboard .dashboard-cards {
            grid-template-columns: 1fr;
        }

        .staff-quick-actions {
            grid-template-columns: 1fr;
        }

        .staff-section {
            padding: 20px;
        }
    }
</style>

<div class="staff-dashboard">

    <div class="staff-heading">
        <h1>STAFF DASHBOARD</h1>
        <p>
            Welcome to Bill's Resort Staff Management.
            Manage daily resort operations here.
        </p>
    </div>

    {# STAFF STATISTICS #}

    <div class="dashboard-cards">

        <div class="dashboard-card">
            <h3>TOTAL BOOKINGS</h3>
            <p class="number">{{ totalBookings }}</p>
        </div>

        <div class="dashboard-card">
            <h3>PENDING BOOKINGS</h3>
            <p class="number">{{ pendingBookings }}</p>
        </div>

        <div class="dashboard-card">
            <h3>CONFIRMED BOOKINGS</h3>
            <p class="number">{{ confirmedBookings }}</p>
        </div>

        <div class="dashboard-card">
            <h3>TOTAL MESSAGES</h3>
            <p class="number">{{ totalMessages }}</p>
        </div>

    </div>

    {# STAFF QUICK ACTIONS #}

    <div class="staff-section">

        <div class="staff-section-header">
            <h2>QUICK ACTIONS</h2>
        </div>

        <div class="staff-quick-actions">

            <a href="{{ path('app_staff_profile') }}" class="staff-action-btn">
                MY PROFILE
            </a>

            <a href="{{ path('app_booking_index') }}" class="staff-action-btn">
                MANAGE BOOKINGS
            </a>

            <a href="{{ path('app_message_index') }}" class="staff-action-btn">
                VIEW MESSAGES
            </a>

        </div>

    </div>

    {# STAFF REMINDERS #}

    <div class="staff-section">

        <div class="staff-section-header">
            <h2>STAFF REMINDERS</h2>
        </div>

        <div class="staff-reminder">
            Review pending bookings regularly. Keep customer messages updated
            and check new reviews to help maintain excellent customer service.
        </div>

    </div>

</div>

{% endblock %}
