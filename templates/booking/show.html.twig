
{% extends 'base.html.twig' %}

{% block title %}Booking Details | Bill's Resort{% endblock %}

{% block body %}

<style>
    .booking-view-page {
        max-width: 950px;
        margin: 0 auto;
        padding: 10px 0 40px;
    }

    .booking-view-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .booking-view-header h1 {
        color: #124d57;
        font-family: 'Lora', serif;
        font-size: 27px;
        margin: 0 0 8px;
    }

    .booking-view-header p {
        color: #718386;
        font-size: 14px;
        margin: 0;
    }

    .booking-view-card {
        background: #ffffff;
        border: 1px solid #dce9e9;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 3px 12px rgba(18, 77, 87, 0.05);
    }

    .booking-view-card h2 {
        color: #124d57;
        font-size: 17px;
        margin: 0 0 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e3eded;
    }

    .booking-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .booking-detail {
        background: #f7fafa;
        border: 1px solid #edf2f2;
        border-radius: 8px;
        padding: 16px;
        min-width: 0;
    }

    .booking-detail label {
        display: block;
        color: #718386;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .booking-detail p {
        color: #294f54;
        font-size: 14px;
        font-weight: 600;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .booking-view-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #e5f3f3;
        color: #17606b;
        font-size: 11px;
        font-weight: 700;
    }

    .booking-view-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e3eded;
    }

    .booking-view-btn {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 7px;
        background: #17606b;
        color: #ffffff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        border: none;
        cursor: pointer;
    }

    .booking-view-btn:hover {
        background: #124d57;
    }

    .booking-view-btn.back {
        background: #eaf2f2;
        color: #17606b;
    }

    .booking-view-btn.back:hover {
        background: #dce9e9;
    }

    @media (max-width: 650px) {
        .booking-view-card {
            padding: 20px;
        }

        .booking-details {
            grid-template-columns: 1fr;
        }

        .booking-view-header h1 {
            font-size: 23px;
        }

        .booking-view-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .booking-view-actions a {
            text-align: center;
        }
    }
</style>

<div class="booking-view-page">

    <div class="booking-view-header">
        <div>
            <h1>BOOKING DETAILS</h1>
            <p>View the complete reservation information.</p>
        </div>
    </div>

    <div class="booking-view-card">

        <h2>RESERVATION INFORMATION</h2>

        <div class="booking-details">

            <div class="booking-detail">
                <label>Booking ID</label>
                <p>#{{ booking.id }}</p>
            </div>

            <div class="booking-detail">
                <label>Customer Name</label>
                <p>{{ booking.customerName }}</p>
            </div>

            <div class="booking-detail">
                <label>Email Address</label>
                <p>{{ booking.email }}</p>
            </div>

            <div class="booking-detail">
                <label>Contact Number</label>
                <p>{{ booking.contactNumber }}</p>
            </div>

            <div class="booking-detail">
                <label>Room</label>
                <p>{{ booking.room ? booking.room.roomName : 'No room assigned' }}</p>
            </div>

            <div class="booking-detail">
                <label>Check-in Date</label>
                <p>{{ booking.checkIn ? booking.checkIn|date('M d, Y') : '—' }}</p>
            </div>

            <div class="booking-detail">
                <label>Check-out Date</label>
                <p>{{ booking.checkOut ? booking.checkOut|date('M d, Y') : '—' }}</p>
            </div>

            <div class="booking-detail">
                <label>Total Price</label>
                <p>₱{{ booking.totalPrice|number_format(2, '.', ',') }}</p>
            </div>

            <div class="booking-detail">
                <label>Booking Status</label>
                <p>
                    <span class="booking-view-status">
                        {{ booking.status|default('Pending')|capitalize }}
                    </span>
                </p>
            </div>

            <div class="booking-detail">
                <label>Date Created</label>
                <p>{{ booking.createdAt ? booking.createdAt|date('M d, Y h:i A') : '—' }}</p>
            </div>

        </div>

        <div class="booking-view-actions">

            <a href="{{ path('app_booking_index') }}" class="booking-view-btn back">
                BACK TO BOOKINGS
            </a>

            {% if is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="booking-view-btn">
                    EDIT BOOKING
                </a>

                {{ include('booking/_delete_form.html.twig') }}
            {% endif %}

        </div>

    </div>

</div>

{% endblock %}
