{% extends 'base.html.twig' %}

{% block title %}Booking index{% endblock %}

{% block body %}
    <h1>Booking index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>CustomerName</th>
                <th>Email</th>
                <th>ContactNumber</th>
                <th>CheckIn</th>
                <th>CheckOut</th>
                <th>TotalPrice</th>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for booking in bookings %}
            <tr>
                <td>{{ booking.id }}</td>
                <td>{{ booking.customerName }}</td>
                <td>{{ booking.email }}</td>
                <td>{{ booking.contactNumber }}</td>
                <td>{{ booking.checkIn ? booking.checkIn|date('Y-m-d') : '' }}</td>
                <td>{{ booking.checkOut ? booking.checkOut|date('Y-m-d') : '' }}</td>
                <td>{{ booking.totalPrice }}</td>
                <td>{{ booking.status }}</td>
                <td>{{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_booking_show', {'id': booking.id}) }}">show</a>
                    <a href="{{ path('app_booking_edit', {'id': booking.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_booking_new') }}">Create new</a>
{% endblock %}
