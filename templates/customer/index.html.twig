
{% extends 'base.html.twig' %}

{% block title %}My Bookings | Bill's Resort{% endblock %}

{% block body %}

<div class="admin-section">

    <div class="admin-section-header">
        <h2>MY BOOKINGS</h2>
    </div>

    {% for message in app.flashes('success') %}
        <p class="success-message">{{ message }}</p>
    {% endfor %}

    <p>Here you can view the status of your room reservations.</p>

    <br>

    <a href="{{ path('app_customer_booking_new') }}" class="admin-btn">
        BOOK ANOTHER ROOM
    </a>

    <br><br>

    {% if bookings is empty %}

        <p>You don't have any bookings yet.</p>

    {% else %}

        <div style="overflow-x: auto;">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>ROOM</th>
                        <th>CHECK-IN</th>
                        <th>CHECK-OUT</th>
                        <th>TOTAL PRICE</th>
                        <th>STATUS</th>
                    </tr>
                </thead>

                <tbody>

                    {% for booking in bookings %}

                        <tr>
                            <td>{{ booking.room.roomName }}</td>

                            <td>{{ booking.checkIn|date('M d, Y') }}</td>

                            <td>{{ booking.checkOut|date('M d, Y') }}</td>

                            <td>₱{{ booking.totalPrice|number_format(2) }}</td>

                            <td>{{ booking.status }}</td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    {% endif %}

    <br>

    <a href="{{ path('app_home') }}" class="admin-btn">
        BACK TO HOME
    </a>

</div>

{% endblock %}
