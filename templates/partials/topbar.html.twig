
<header class="admin-header">

    <div class="admin-logo">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('images/mainlogo.jpg') }}" alt="Bill's Resort Logo">
        </a>
    </div>

    <div class="admin-user">

        {% if app.user %}

            {% if is_granted('ROLE_CUSTOMER') %}
                <a href="{{ path('app_review_new') }}" class="logout-btn">
                    WRITE A REVIEW
                </a>
            {% endif %}

            <span>
                Welcome, {{ app.user.name }}
            </span>

            <a href="{{ path('app_logout') }}" class="logout-btn">
                LOGOUT
            </a>

        {% else %}

            <a href="{{ path('app_login') }}" class="logout-btn">
                LOGIN
            </a>

        {% endif %}

    </div>

</header>
